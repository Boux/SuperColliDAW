FROM docker.io/library/fedora:44

RUN dnf -y install mingw64-gcc-c++ mingw64-winpthreads-static mingw64-fftw mingw64-fftw-static cmake ninja-build patch \
    && dnf clean all

# SuperCollider includes these with MSVC's capitals; MinGW's headers are lowercase and Linux paths are case-sensitive.
RUN cd /usr/x86_64-w64-mingw32/sys-root/mingw/include && ln -s windows.h Windows.h && ln -s winsock2.h WinSock2.h && ln -s shlobj.h Shlobj.h

# TODO: build libogg, libvorbis, flac and opus statically too, so Buffer.read handles the same formats as on Linux.
# libsndfile 1.2.2 asks for CMake 3.1, which CMake 4 refuses without a policy minimum.
ARG LIBSNDFILE_VERSION=1.2.2
RUN curl -fsSL https://github.com/libsndfile/libsndfile/releases/download/${LIBSNDFILE_VERSION}/libsndfile-${LIBSNDFILE_VERSION}.tar.xz | tar --no-same-owner -xJ -C /tmp \
    && mingw64-cmake -S /tmp/libsndfile-${LIBSNDFILE_VERSION} -B /tmp/libsndfile-build -G Ninja -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_SHARED_LIBS=OFF -DENABLE_EXTERNAL_LIBS=OFF -DENABLE_MPEG=OFF -DBUILD_PROGRAMS=OFF -DBUILD_EXAMPLES=OFF -DBUILD_TESTING=OFF -DENABLE_CPACK=OFF -DINSTALL_MANPAGES=OFF \
    && cmake --build /tmp/libsndfile-build \
    && cmake --install /tmp/libsndfile-build \
    && rm -rf /tmp/libsndfile-*
